# Apache Kafka Broker (Internal container: kafka:9092, Host access: localhost:19092)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRIPS=taxi.trips.live

# Redis State Cache & Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Simulator Tuning
EVENTS_PER_SECOND=6.0
ANOMALY_RATE=0.08
MAX_CONCURRENT_TRIPS=120

# Stream Processing & Anomaly Thresholds
Z_SCORE_THRESHOLD=2.5
SURGE_MULTIPLIER_THRESHOLD=2.0
SLIDING_WINDOW_SECONDS=60

# Streamlit Live Dashboard
DASHBOARD_PORT=8501
REFRESH_INTERVAL_MS=2000

